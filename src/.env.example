APP_NAME="Chat With Knowledge Base"
ENVIRONMENT="local"
LOG_LEVEL="INFO"

# LangSmith Telemetry / Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="lsv2_pt_..."
LANGCHAIN_PROJECT="default-chain-engine"

# Generation Specs
GENERATION_PROVIDER="OPENAI"
GENERATION_MODEL_NAME="gpt-4o-mini"
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1
INPUT_DEFAULT_MAX_CHARACTERS=1024

# Embedding Specs
EMBEDDING_PROVIDER="COHERE"
EMBEDDING_MODEL_NAME="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

OPEANAI_API_KEY="your-openai-api-key-here"
OPEANAI_API_URL="your-openai-api-url-here"
GOOGLE_API_KEY="your-openai-api-key-here"

VECTORSTORE_PROVIDER="CHROMA"
VECTORSTORE_COLLECTION_NAME="rag_knowledge_base"
VECTORSTORE_PERSIST_DIR="src/assets/vectorstores"

# Retrieval Specs
RETRIEVAL_SEARCH_TYPE="similarity"
RETRIEVAL_K=4
