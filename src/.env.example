# Default Model Specs
DEFAULT_MODEL_PROVIDER="OPENAI"
DEFAULT_MODEL_NAME="gpt-4o-mini"
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=512
